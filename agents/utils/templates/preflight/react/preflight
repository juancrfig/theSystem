#!/usr/bin/env bash
set -uo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit 1
workspace="$PWD"
until [[ -f "$workspace/agents/utils/scripts/preflight/common.sh" ]]; do
    if [[ "$workspace" == / ]]; then
        printf 'FAIL Cannot locate agents/utils/scripts/preflight/AGENTS.md.\n'
        exit 1
    fi
    workspace="$(dirname -- "$workspace")"
done
source "$workspace/agents/utils/scripts/preflight/common.sh"

# Adapt pin sources to the clone; never introduce a second version authority.
node_pin=$(cat .nvmrc 2>/dev/null) || node_pin=''
check_exact Node "$node_pin" .nvmrc node --version
manager_pin=$(json_pin package.json packageManager) || manager_pin=''
case "$manager_pin" in
    npm@*|pnpm@*|yarn@*)
        check_exact "${manager_pin%%@*}" "${manager_pin#*@}" package.json \
            "${manager_pin%%@*}" --version
        ;;
    *) fail 'Package manager: resolve the exact pin in the clone configuration.' ;;
esac

# Replace this failure with checks for installed locked dependencies and the
# headless tools/system capabilities required by the clone's actual test routes.
fail 'React template incomplete: add clone-specific readiness checks before accepting green.'
finish_preflight
