#!/usr/bin/env bash
# theSystem installer (feature F1 in FEATURES.md).
#   curl -fsSL https://raw.githubusercontent.com/juancrfig/theSystem/master/install | bash
# THESYSTEM_WORKSPACE and THESYSTEM_COMPANY answer the two prompts without asking.
set -euo pipefail

fail() { printf 'install: %s\n' "$1" >&2; exit 1; }
for tool in python3 git; do
  command -v "$tool" >/dev/null 2>&1 || fail "$tool is required"
done

source_root=""
if [[ -n "${BASH_SOURCE[0]:-}" && -f "$(dirname "${BASH_SOURCE[0]}")/thesystem/cli.py" ]]; then
  source_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
else
  command -v curl >/dev/null 2>&1 || fail "curl is required"
  download=$(mktemp -d)
  trap 'rm -rf "$download"' EXIT
  curl -fsSL "https://codeload.github.com/juancrfig/theSystem/tar.gz/refs/heads/${THESYSTEM_BRANCH:-master}" \
    | tar -xz -C "$download" || fail "could not download theSystem"
  source_root=$(find "$download" -mindepth 1 -maxdepth 1 -type d | head -n 1)
fi

ask() {
  local preset=$1 question=$2 default=$3 answer=""
  if [[ -n "$preset" ]]; then printf '%s\n' "$preset"; return; fi
  if { exec 3</dev/tty; } 2>/dev/null; then
    printf '%s [%s]: ' "$question" "$default" >/dev/tty
    read -r answer <&3 || true
    exec 3<&-
  fi
  printf '%s\n' "${answer:-$default}"
}

workspace=$(ask "${THESYSTEM_WORKSPACE:-}" "Workspace location" "$HOME/workspace")
workspace=${workspace/#\~/$HOME}
company=$(ask "${THESYSTEM_COMPANY:-}" "Company name" "umbrella")
[[ "$company" =~ ^[a-z][a-z0-9-]*$ ]] || fail "company name must be lowercase letters, digits or '-': $company"

bin_dir="$HOME/.local/bin"
share_dir="$HOME/.local/share/thesystem"
launcher="$bin_dir/$company"
if [[ -e "$launcher" ]] && ! grep -q 'theSystem launcher' "$launcher"; then
  fail "$launcher already exists and is not a theSystem command"
fi

# The installed code is replaced on every install; the workspace is only ever added to.
mkdir -p "$bin_dir" "$(dirname "$share_dir")"
rm -rf "$share_dir"
mkdir -p "$share_dir"
cp -R "$source_root/thesystem" "$share_dir/thesystem"

mkdir -p "$workspace/docs" "$workspace/agents/rules" "$workspace/agents/skills" "$workspace/agents/tools"
workspace=$(cd "$workspace" && pwd -P)
seed() {
  local from=$1 to=$2 file
  (cd "$from" && find . \( -type f -o -type l \) -print) | while IFS= read -r file; do
    file=${file#./}
    if [[ ! -e "$to/$file" && ! -L "$to/$file" ]]; then
      mkdir -p "$(dirname "$to/$file")"
      cp -P "$from/$file" "$to/$file"
      if [[ "$file" == AGENTS.md && "$to" == "$workspace" ]]; then
        sed -i "s/{{COMMAND}}/$company/g" "$to/$file"
      fi
    fi
  done
}
seed "$source_root/workspace" "$workspace"
seed "$source_root/agents" "$workspace/agents"

[[ -e "$workspace/.git" ]] || git -C "$workspace" init -q
if [[ ! -e "$workspace/.agents/skills" && ! -L "$workspace/.agents/skills" ]]; then
  mkdir -p "$workspace/.agents"
  ln -s ../agents/skills "$workspace/.agents/skills"
fi

# Trust the workspace so Hermes loads its skills (.agents/skills). Hermes ignores repo-local skills until trusted.
if command -v hermes >/dev/null 2>&1; then
  hermes skills trust "$workspace" >/dev/null 2>&1 || true
fi

# Hermes personalities: `main` is the build-mode communication rule, `casual` adds nothing (plain Hermes).
# Switch with `/personality casual` in chat or `hermes config set display.personality casual`.
# Skipped when Hermes isn't installed; rerun the installer after installing it.
# Hermes reads the harness from the theSystem being installed, so every install brings its canonical version.
harness="$source_root/agents/.harness"
main_style="$harness/personalities/main.md"
if command -v hermes >/dev/null 2>&1 && [[ -f "$main_style" ]]; then
  hermes config set personalities.main "$(cat "$main_style")" >/dev/null || true
  hermes config set personalities.casual "" >/dev/null || true
  if [[ -z "$(hermes config get display.personality 2>/dev/null)" ]]; then
    hermes config set display.personality main >/dev/null || true
  fi
fi

# Main agent: canonical Hermes config and toolsets from the harness. Every install resets these keys, so the
# harness files win over hand edits. Auxiliary models are not touched; the human configures them.
if command -v hermes >/dev/null 2>&1 && [[ -f "$harness/canonical_config.yaml" ]]; then
  PYTHONPATH="$share_dir" python3 -m thesystem.harness settings "$harness/canonical_config.yaml" \
  | while IFS=$'\t' read -r key value; do
      hermes config set "$key" "$value" >/dev/null || true
    done
fi
if command -v hermes >/dev/null 2>&1 && [[ -f "$harness/required_toolsets.txt" ]]; then
  mapfile -t toolsets < <(grep -v '^\s*#' "$harness/required_toolsets.txt" | grep -v '^\s*$')
  if (( ${#toolsets[@]} )); then
    for platform in cli telegram; do
      hermes tools enable --platform "$platform" "${toolsets[@]}" >/dev/null 2>&1 || true
    done
  fi
fi
# Worker and reviewer profiles (F4): created empty; their configuration comes later. They inherit the main
# agent's credentials: the login store is shared (a link, so OAuth refreshes stay valid for every profile),
# and API keys are copied on each install without messaging-channel credentials such as bot tokens.
if command -v hermes >/dev/null 2>&1 && [[ -f "$harness/canonical_profiles.txt" ]]; then
  hermes_root="${HERMES_HOME:-$HOME/.hermes}"
  while read -r profile; do
    [[ -z "$profile" || "$profile" == \#* ]] && continue
    hermes profile show "$profile" >/dev/null 2>&1 \
      || hermes profile create "$profile" --no-alias --no-skills >/dev/null 2>&1 || true
    profile_dir="$hermes_root/profiles/$profile"
    [[ -d "$profile_dir" ]] || continue
    if [[ -f "$hermes_root/auth.json" && ! "$profile_dir/auth.json" -ef "$hermes_root/auth.json" ]]; then
      ln -sfn "$hermes_root/auth.json" "$profile_dir/auth.json"
    fi
    PYTHONPATH="$share_dir" python3 -m thesystem.harness keys "$hermes_root/.env" "$profile_dir/.env" || true
  done < "$harness/canonical_profiles.txt"
fi

# Artifact library (F9): an always-on user service serving the workspace's HTML artifacts on localhost.
# Skipped without a systemd user session. Linger keeps it running after reboots without a login.
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  unit_dir="$HOME/.config/systemd/user"
  mkdir -p "$unit_dir"
  cat > "$unit_dir/thesystem-artifacts.service" <<EOF
[Unit]
Description=theSystem artifact library (http://localhost:8765)

[Service]
Environment=THESYSTEM_WORKSPACE=$workspace
Environment=PYTHONPATH=$share_dir
ExecStart=/usr/bin/env python3 -m thesystem.artifacts
Restart=on-failure

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable thesystem-artifacts.service >/dev/null 2>&1 || true
  systemctl --user restart thesystem-artifacts.service >/dev/null 2>&1 || true
  loginctl enable-linger "${USER:-$(id -un)}" >/dev/null 2>&1 || true
fi

cat > "$launcher" <<EOF
#!/bin/sh
# theSystem launcher for the $company workspace
THESYSTEM_WORKSPACE='$workspace' THESYSTEM_COMMAND='$company' PYTHONPATH='$share_dir' exec python3 -m thesystem.cli "\$@"
EOF
chmod +x "$launcher"

printf '\nDone. Workspace: %s\nCommand: %s\n' "$workspace" "$company"
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) printf 'Add %s to your PATH to use it.\n' "$bin_dir" ;;
esac
