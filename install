#!/usr/bin/env bash
# theSystem installer (features F1 and F10 in FEATURES.md).
#   curl -fsSL https://raw.githubusercontent.com/juancrfig/theSystem/master/install | bash
# Installs the newest commit of the master branch from the server's clone (~/theSystem, cloned when missing). The release is
# read straight from git, so the clone's branch and working files are never touched.
#   install --dev   installs the working tree this script is in instead (theSystem development).
# THESYSTEM_WORKSPACE and THESYSTEM_COMPANY answer the two prompts without asking. THESYSTEM_REPO and
# THESYSTEM_CLONE choose where theSystem is cloned from and to.
# --release <tag> and --update are internal: the release's own installer runs with them.
set -euo pipefail

# Progress: one line per step, with a spinner while it runs when the output is a terminal, so a slow step never
# looks frozen. Without a terminal (`update`) only the finished lines are printed.
spin_pid="" spin_label="" release_dir=""
if [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ [Uu][Tt][Ff]-?8 ]]; then
  frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) mark_ok="✓" mark_failed="✗"
else
  frames=('|' '/' '-' '\') mark_ok="+" mark_failed="x"
fi

step() {
  end_step
  spin_label=$1
  [[ -t 1 ]] || return 0
  printf '\e[?25l'
  # Stops by itself if the installer dies without cleaning up.
  ( while kill -0 $$ 2>/dev/null; do
      for frame in "${frames[@]}"; do printf '\r  %s %s' "$frame" "$spin_label"; sleep 0.1; done
    done ) &
  spin_pid=$!
}

end_step() {
  [[ -n "$spin_label" ]] || return 0
  if [[ -n "$spin_pid" ]]; then
    kill "$spin_pid" 2>/dev/null || true
    wait "$spin_pid" 2>/dev/null || true
    spin_pid=""
    printf '\r\e[K\e[?25h'
  fi
  printf '  %s %s\n' "${1:-$mark_ok}" "$spin_label"
  spin_label=""
}

cleanup() {
  local status=$?
  if (( status )); then end_step "$mark_failed"; else end_step; fi
  [[ -z "$release_dir" ]] || rm -rf "$release_dir"
}
trap cleanup EXIT

fail() { end_step "$mark_failed"; printf 'install: %s\n' "$1" >&2; exit 1; }
for tool in python3 git; do
  command -v "$tool" >/dev/null 2>&1 || fail "$tool is required"
done

dev=0 release="" update=0
while (( $# )); do
  case $1 in
    --dev) dev=1 ;;
    --release) [[ $# -ge 2 ]] || fail "--release needs a tag"; release=$2; shift ;;
    --update) update=1 ;;
    *) fail "unknown option: $1" ;;
  esac
  shift
done
clone="${THESYSTEM_CLONE:-$HOME/theSystem}"
channel=master

here=""
if [[ -n "${BASH_SOURCE[0]:-}" && -f "$(dirname "${BASH_SOURCE[0]}")/thesystem/cli.py" ]]; then
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
fi

# Bootstrap (also what the piped one-liner runs): make sure the clone exists, then hand over to the installer of
# the newest commit on this channel's branch.
if (( ! dev )) && [[ -z "$release" ]]; then
  printf 'theSystem installer\n'
  step "Getting the latest theSystem release"
  if [[ -e "$clone" ]]; then
    git -C "$clone" rev-parse --git-dir >/dev/null 2>&1 || fail "$clone exists but is not a git clone of theSystem"
    git -C "$clone" fetch --quiet --tags --force origin || fail "could not fetch theSystem releases into $clone"
  else
    git clone --quiet "${THESYSTEM_REPO:-https://github.com/juancrfig/theSystem.git}" "$clone" \
      || fail "could not clone theSystem into $clone"
  fi
  # This channel follows the newest commit of its branch; it has no numbered tags.
  git -C "$clone" fetch --quiet origin "+refs/heads/$channel:refs/remotes/origin/$channel" \
    || fail "could not fetch the $channel branch into $clone"
  commit=$(git -C "$clone" rev-parse "refs/remotes/origin/$channel") || fail "no $channel branch in $clone"
  tag="$channel@${commit:0:12}"
  release_dir=$(mktemp -d)
  git -C "$clone" archive "$commit" | tar -x -C "$release_dir" || fail "could not read release $tag"
  spin_label="Got theSystem $tag"
  end_step
  status=0
  # stdin is the rest of this script when piped into bash; the release's installer must not swallow it. The
  # prompts read the terminal directly.
  THESYSTEM_CLONE="$clone" bash "$release_dir/install" --release "$tag" </dev/null || status=$?
  exit "$status"
fi
[[ -n "$here" ]] || fail "--dev and --release need the installer inside a theSystem tree"
source_root=$here
release=${release:-dev}

ask() {
  local preset=$1 question=$2 default=$3 answer=""
  if [[ -n "$preset" ]]; then printf '%s\n' "$preset"; return; fi
  if { exec 3</dev/tty; } 2>/dev/null; then
    printf '%s [%s]: ' "$question" "$default" >/dev/tty
    read -r answer <&3 || true
    exec 3<&-
  fi
  printf '%s\n' "${answer:-$default}"
}

workspace=$(ask "${THESYSTEM_WORKSPACE:-}" "Workspace location" "$HOME/workspace")
workspace=${workspace/#\~/$HOME}
company=$(ask "${THESYSTEM_COMPANY:-}" "Company name" "umbrella")
[[ "$company" =~ ^[a-z][a-z0-9-]*$ ]] || fail "company name must be lowercase letters, digits or '-': $company"

bin_dir="$HOME/.local/bin"
share_dir="$HOME/.local/share/thesystem"
launcher="$bin_dir/$company"
if [[ -e "$launcher" ]] && ! grep -q 'theSystem launcher' "$launcher"; then
  fail "$launcher already exists and is not a theSystem command"
fi
hermes=0
command -v hermes >/dev/null 2>&1 && hermes=1
harness="$source_root/agents/.harness"
hermes_root="${HERMES_HOME:-$HOME/.hermes}"
started=$SECONDS
printf '\nInstalling theSystem %s\n' "$release"

step "Setting up the workspace"
# The installed code is replaced on every install; workspace files change only through `update` (F10).
mkdir -p "$bin_dir" "$(dirname "$share_dir")"
rm -rf "$share_dir"
mkdir -p "$share_dir"
cp -R "$source_root/thesystem" "$share_dir/thesystem"

mkdir -p "$workspace/docs" "$workspace/agents/rules" "$workspace/agents/skills"
workspace=$(cd "$workspace" && pwd -P)
# Only missing files are added; existing ones are the human's. A clean install records its baseline (F10).
# An update merges the files itself once this script is done, so it skips seeding.
if (( ! update )); then
  PYTHONPATH="$share_dir" python3 -m thesystem.update seed --source "$source_root" --workspace "$workspace" \
    --company "$company" --release "$release"
fi

[[ -e "$workspace/.git" ]] || git -C "$workspace" init -q
if [[ ! -e "$workspace/.agents/skills" && ! -L "$workspace/.agents/skills" ]]; then
  mkdir -p "$workspace/.agents"
  ln -s ../agents/skills "$workspace/.agents/skills"
fi

# Hermes may select a named profile even when HERMES_HOME is unset. Ask Hermes rather than writing the
# default profile while its CLI commands configure a different one.
if (( hermes )) && [[ -z "${HERMES_HOME:-}" ]]; then
  if ! config_path=$(hermes config path </dev/null); then
    fail "could not resolve the main Hermes profile"
  fi
  [[ "$config_path" == /*/config.yaml ]] || fail "Hermes returned an invalid config path: $config_path"
  hermes_root=$(dirname "$config_path")
fi

if (( hermes )); then
  step "Configuring Hermes"
  plugin_source="$harness/plugins/thesystem-memory-write-labels"
  plugin_target="$hermes_root/plugins/thesystem-memory-write-labels"
  if [[ ! -f "$plugin_source/plugin.yaml" || ! -f "$plugin_source/__init__.py" ]]; then
    fail "the memory-write labels plugin is missing from the installer"
  fi
  rm -rf "$plugin_target"
  mkdir -p "$(dirname "$plugin_target")"
  cp -R "$plugin_source" "$plugin_target"
  if ! problem=$(hermes plugins enable thesystem-memory-write-labels </dev/null 2>&1); then
    fail "could not enable the memory-write labels plugin: $problem"
  fi
  # Tiered delegation (delegate-tier-router): opt-in, only on servers that have the `agy` CLI. Without agy the
  # router would block delegate_task and point to a pool that cannot run, so it is copied but not enabled.
  router_source="$harness/plugins/delegate-tier-router"
  if [[ -f "$router_source/plugin.yaml" && -f "$harness/bin/agy-pool" ]]; then
    mkdir -p "$hermes_root/plugins" "$bin_dir"
    rm -rf "$hermes_root/plugins/delegate-tier-router"
    cp -R "$router_source" "$hermes_root/plugins/delegate-tier-router"
    cp "$harness/bin/agy-pool" "$bin_dir/agy-pool" && chmod +x "$bin_dir/agy-pool"
    if command -v agy >/dev/null 2>&1; then
      hermes plugins enable delegate-tier-router </dev/null >/dev/null 2>&1 || printf 'warning: could not enable delegate-tier-router\n' >&2
    fi
  fi
  # One pass over the main agent's config (each Hermes command takes a second or more just to start):
  # - Trust the workspace so Hermes loads its skills (.agents/skills); Hermes ignores repo-local skills until trusted.
  # - terminal.cwd: the main agent works there, so every main-agent session (Telegram, cron and CLI, even
  #   `hermes chat --in <elsewhere>`) loads the workspace skills and AGENTS.md.
  # - Personalities: `main` is the build-mode communication rule, `casual` adds nothing (plain Hermes). `main` is
  #   selected only when none is. Switch with `/personality casual` in chat or
  #   `hermes config set display.personality casual`.
  # - The canonical config from the harness. Every install resets these keys, so the harness files win over hand
  #   edits. Auxiliary models are not touched; the human configures them.
  # Hermes reads the harness from the theSystem being installed, so every install brings its canonical version.
  config=(--trust "$workspace" --set terminal.cwd "$workspace")
  # The workspace copy wins: it carries the human's local edits, merged with theSystem's on every update.
  personalities="$harness/personalities"
  [[ -d "$workspace/agents/.harness/personalities" ]] && personalities="$workspace/agents/.harness/personalities"
  if [[ -f "$personalities/main.md" ]]; then
    config+=(--set personalities.main "$(cat "$personalities/main.md")" --set personalities.casual ""
             --default display.personality main)
  fi
  # - Telegram: the owner's DM (TELEGRAM_HOME_CHANNEL) gets the instant-messaging communication style as a channel
  #   prompt. Hermes injects it only for messages from that chat, on top of the `main` personality.
  home_chat=$(grep -s -E '^TELEGRAM_HOME_CHANNEL=-?[0-9]+$' "$hermes_root/.env" | tail -n 1 | cut -d= -f2 || true)
  if [[ -n "$home_chat" && -f "$personalities/telegram.md" ]]; then
    config+=(--set "telegram.channel_prompts.$home_chat" "$(tail -n +3 "$personalities/telegram.md")")
  fi
  [[ -f "$harness/canonical_config.yaml" ]] && config+=(--canonical "$harness/canonical_config.yaml")
  # The harness edits Hermes' config in one pass with PyYAML. The first python3 on PATH can be a venv without it,
  # and the fallback (`hermes config set`) refuses multi-line prompts that look like YAML lists.
  harness_python=python3
  for candidate in python3 /usr/bin/python3; do
    if "$candidate" -c 'import yaml' >/dev/null 2>&1; then harness_python=$candidate; break; fi
  done
  if ! problem=$(PYTHONPATH="$share_dir" "$harness_python" -m thesystem.harness apply "$hermes_root" "${config[@]}" 2>&1); then
    fail "${problem#install: }"
  fi
  if [[ -f "$harness/required_toolsets.txt" ]]; then
    mapfile -t toolsets < <(grep -v '^\s*#' "$harness/required_toolsets.txt" | grep -v '^\s*$')
    if (( ${#toolsets[@]} )); then
      for platform in cli telegram; do
        if ! problem=$(hermes tools enable --platform "$platform" "${toolsets[@]}" </dev/null 2>&1); then
          fail "could not enable required Hermes toolsets for $platform: $problem"
        fi
      done
    fi
  fi
  if ! problem=$(PYTHONPATH="$share_dir" "${harness_python:-python3}" -m thesystem.harness verify "$workspace" 2>&1); then
    fail "${problem#install: }"
  fi
fi

# Monitor scheduler: deterministic health checks run outside Hermes every five minutes.
# It uses the selected Hermes profile and the canonical theSystem clone; no Hermes cron job is installed.
# systemd unit values sit inside double quotes; escape backslashes, quotes and % (systemd specifiers)
# so paths with spaces or special characters still produce a valid unit.
systemd_escape_value() {
  local v=${1//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//%/%%}
  printf '%s' "$v"
}

if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  step "Starting the Monitor scheduler"
  # An empty contracts directory is a valid "nothing approved yet" state; a missing one is a scheduler error.
  mkdir -p "$hermes_root/monitor/contracts"
  unit_dir="$HOME/.config/systemd/user"
  mkdir -p "$unit_dir"
  cat > "$unit_dir/thesystem-monitor.service" <<EOF
[Unit]
Description=theSystem Monitor health-check scheduler

[Service]
Type=oneshot
Environment="HERMES_HOME=$(systemd_escape_value "$hermes_root")"
Environment="THESYSTEM_CLONE=$(systemd_escape_value "$clone")"
Environment="PYTHONPATH=$(systemd_escape_value "$share_dir")"
# Checks call hermes and the workspace command, which live outside systemd's default PATH.
Environment="PATH=$(systemd_escape_value "$HOME/.local/bin:$(dirname "$(command -v hermes 2>/dev/null || echo /usr/bin/hermes)"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")"
Environment="THESYSTEM_WORKSPACE=$(systemd_escape_value "$workspace")"
ExecStart=/usr/bin/env python3 -m thesystem.scheduler
EOF
  cat > "$unit_dir/thesystem-monitor.timer" <<'EOF'
[Unit]
Description=Run the theSystem Monitor every five minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
AccuracySec=1s
Persistent=true
Unit=thesystem-monitor.service

[Install]
WantedBy=timers.target
EOF
  # The Monitor depends on this timer, so a provisioning failure is reported instead of swallowed.
  if ! { systemctl --user daemon-reload && systemctl --user enable thesystem-monitor.timer \
         && systemctl --user restart thesystem-monitor.timer; } >/dev/null 2>&1; then
    echo "WARNING: the Monitor scheduler timer (thesystem-monitor.timer) could not be enabled; health checks will not run." >&2
  fi
  loginctl enable-linger "${USER:-$(id -un)}" >/dev/null 2>&1 || true
fi

# Artifact library (F9): an always-on user service serving the workspace's HTML artifacts on localhost.
# Skipped without a systemd user session. Linger keeps it running after reboots without a login.
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  step "Starting the artifact library"
  unit_dir="$HOME/.config/systemd/user"
  mkdir -p "$unit_dir"
  cat > "$unit_dir/thesystem-artifacts.service" <<EOF
[Unit]
Description=theSystem artifact library (http://localhost:8765)

[Service]
Environment=THESYSTEM_WORKSPACE=$workspace
Environment=PYTHONPATH=$share_dir
ExecStart=/usr/bin/env python3 -m thesystem.artifacts
Restart=on-failure

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  systemctl --user enable thesystem-artifacts.service >/dev/null 2>&1 || true
  systemctl --user restart thesystem-artifacts.service >/dev/null 2>&1 || true
  loginctl enable-linger "${USER:-$(id -un)}" >/dev/null 2>&1 || true
fi

# Push guard: theSystem is public, so every push from this clone is screened for company data first.
if git -C "$clone" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$clone" config core.hooksPath agents/.harness/git-hooks
  git -C "$clone" config thesystem.workspace "$workspace"
fi

step "Adding the $company command"
cat > "$launcher" <<EOF
#!/bin/sh
# theSystem launcher for the $company workspace
THESYSTEM_WORKSPACE='$workspace' THESYSTEM_COMMAND='$company' THESYSTEM_CLONE='$clone' PYTHONPATH='$share_dir' exec python3 -m thesystem.cli "\$@"
EOF
chmod +x "$launcher"
end_step

(( hermes )) || printf '  - Hermes not found: its setup was skipped; run the installer again after installing it.\n'
printf '\nDone in %ss. Workspace: %s\nCommand: %s\n' "$(( SECONDS - started ))" "$workspace" "$company"
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) printf 'Add %s to your PATH to use it.\n' "$bin_dir" ;;
esac
