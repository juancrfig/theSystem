#!/usr/bin/env bash
# theSystem distribution installer. Safe for: curl ... | bash
set -euo pipefail

PROFILE=master
HERMES_HOME_ROOT="${HERMES_HOME:-$HOME/.hermes}"
HERMES_INSTALL_URL="${THESYSTEM_HERMES_INSTALL_URL:-https://hermes-agent.nousresearch.com/install.sh}"
ARCHIVE_URL="${THESYSTEM_ARCHIVE_URL:-https://codeload.github.com/juancrfig/theSystem/tar.gz/refs/heads/${THESYSTEM_BRANCH:-master}}"

say() { printf '[theSystem] %s\n' "$*"; }
die() { printf '[theSystem] error: %s\n' "$*" >&2; exit 1; }
usage() {
  printf '%s\n' \
    'Usage: install [--workspace PATH] [--company NAME] [--runtime hermes|copilot] [--blank=yes] [--non-interactive] [--experimental]' '' \
    'Installs distribution files (not a git checkout), then configures the' \
    'dedicated Hermes profile master. The default profile is not modified.' \
    'Experimental rules and skills are excluded unless --experimental is passed.'
}

workspace=''; company=''; runtime=hermes; blank=0; non_interactive=0; experimental=0
lifecycle=install
rollback_id=''
replace_managed=0

while (($#)); do
  case "$1" in
    --workspace) (($# >= 2)) || die '--workspace needs a path'; workspace=$2; shift 2 ;;
    --company) (($# >= 2)) || die '--company needs a name'; company=$2; shift 2 ;;
    --runtime) (($# >= 2)) || die '--runtime needs hermes or copilot'; runtime=$2; shift 2 ;;
    --blank=yes) blank=1; shift ;;
    --non-interactive) non_interactive=1; shift ;;
    --experimental) experimental=1; shift ;;
    --upgrade) lifecycle=upgrade; shift ;;
    --rollback) lifecycle=rollback; shift ;;
    --uninstall) lifecycle=uninstall; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ "$runtime" == hermes || "$runtime" == copilot ]] || die '--runtime must be hermes or copilot'
(( blank )) && runtime=none

require_command() { command -v "$1" >/dev/null 2>&1 || die "required command is not available: $1"; }

ensure_python() {
  if command -v python3 >/dev/null 2>&1; then return; fi
  local privilege=()
  if [[ "$(id -u)" != 0 ]]; then
    require_command sudo
    privilege=(sudo)
  fi
  if command -v apt-get >/dev/null 2>&1; then
    "${privilege[@]}" apt-get update
    "${privilege[@]}" apt-get install -y python3
  elif command -v pacman >/dev/null 2>&1; then
    "${privilege[@]}" pacman -Sy --needed --noconfirm python
  else
    die 'Python 3 is required; no supported package manager (apt-get/pacman) found'
  fi
  require_command python3
}

ensure_runtime_prerequisites() {
  # Minimal distribution images can have Python but no download or Git tools.
  # Install supported system packages before invoking vendor installers.
  local missing=0 tool privilege=()
  for tool in curl git tar; do
    command -v "$tool" >/dev/null 2>&1 || missing=1
  done
  python3 -c 'import ctypes; ctypes.CDLL("libatomic.so.1")' >/dev/null 2>&1 || missing=1
  (( missing )) || return 0
  if [[ "$(id -u)" != 0 ]]; then
    require_command sudo
    privilege=(sudo)
  fi
  if command -v apt-get >/dev/null 2>&1; then
    "${privilege[@]}" apt-get update
    "${privilege[@]}" apt-get install -y curl ca-certificates git tar libatomic1
  elif command -v pacman >/dev/null 2>&1; then
    "${privilege[@]}" pacman -Sy --needed --noconfirm curl ca-certificates git tar gcc-libs
  else
    die 'curl, Git, and tar are required; no supported package manager (apt-get/pacman) found'
  fi
  for tool in curl git tar; do require_command "$tool"; done
}

ensure_hermes() {
  if command -v hermes >/dev/null 2>&1; then
    hermes --version >/dev/null 2>&1 || die 'Hermes is on PATH but failed verification'
  else
    require_command curl
    say 'Hermes not found; running the official Hermes installer' >&2
    curl --fail --location --silent --show-error "$HERMES_INSTALL_URL" | bash
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  fi
  require_command hermes
  hermes --version >/dev/null 2>&1 || die 'Hermes failed verification'
}

ensure_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    require_command curl
    say 'uv not found; running the official uv installer' >&2
    curl --fail --location --silent --show-error https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  fi
  require_command uv
  uv --version >/dev/null 2>&1 || die 'uv failed verification'
}

ensure_copilot() {
  if ! command -v copilot >/dev/null 2>&1; then
    require_command curl
    say 'Copilot CLI not found; running the official GitHub installer' >&2
    curl --fail --location --silent --show-error https://gh.io/copilot-install | bash
    export PATH="$HOME/.local/bin:$HOME/.local/share/npm/bin:$PATH"
  fi
  require_command copilot
  copilot --version >/dev/null 2>&1 || die 'Copilot CLI failed verification'
}

ensure_herdr() {
  if ! command -v herdr >/dev/null 2>&1; then
    require_command curl
    say 'Herdr not found; running the official Herdr installer' >&2
    curl --fail --location --silent --show-error "${THESYSTEM_HERDR_INSTALL_URL:-https://herdr.dev/install.sh}" | sh
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  fi
  require_command herdr
  herdr --version >/dev/null 2>&1 || die 'Herdr failed verification'
}

ask_workspace() {
  local answer=''
  [[ -n "$workspace" ]] && return
  if (( non_interactive )); then workspace="$HOME/workspace"
  elif [[ -r /dev/tty && -w /dev/tty ]]; then
    printf 'Workspace directory [~/workspace]: ' >/dev/tty
    IFS= read -r answer </dev/tty || true
    workspace="${answer:-$HOME/workspace}"
  else
    workspace="$HOME/workspace"
    say "No terminal available; using $workspace"
  fi
  workspace="${workspace/#\~/$HOME}"
}

validate_company_name() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || die 'company name must be one ASCII word matching [A-Za-z][A-Za-z0-9]*'
}

ask_company() {
  local answer=''
  [[ -n "$company" ]] && { validate_company_name "$company"; return; }
  if (( non_interactive )); then die '--company is required with --non-interactive'; fi
  [[ -r /dev/tty && -w /dev/tty ]] || return
  printf 'Company command name (blank to skip): ' >/dev/tty
  IFS= read -r answer </dev/tty || true
  [[ -n "$answer" ]] || return
  company=$answer
  validate_company_name "$company"
}

find_local_distribution() {
  local source=${BASH_SOURCE[0]:-} root
  [[ -n "$source" && "$source" != bash && -f "$source" ]] || return 1
  root=$(cd "$(dirname "$source")" && pwd -P)
  [[ -f "$root/agents/roles.yaml" && -f "$root/CONTEXT.md" ]] || return 1
  printf '%s\n' "$root"
}

download_distribution() {
  local staging archive extracted
  require_command curl; require_command tar
  mkdir -p "${TMPDIR:-$HOME/.cache}"
  staging=$(mktemp -d "${TMPDIR:-$HOME/.cache}/thesystem.XXXXXX")
  archive="$staging/source.tar.gz"
  say "Downloading distribution from $ARCHIVE_URL" >&2
  curl --fail --location --silent --show-error "$ARCHIVE_URL" -o "$archive" || die 'distribution download failed'
  tar -xzf "$archive" -C "$staging" || die 'distribution archive extraction failed'
  extracted=$(find "$staging" -mindepth 1 -maxdepth 1 -type d -print -quit)
  [[ -n "$extracted" ]] || die 'downloaded archive contained no directory'
  printf '%s\n' "$extracted"
}

# Only these paths are distribution inputs. In particular, runtime state, .env,
# .scratch, tests, and the source checkout's generated .agents are never copied.
allowed_distribution_paths=(AGENTS.md CONTEXT.md MANUAL.md README.md orchestrator the_system_orchestrator.py installer_lifecycle.py bootstrap install company_cli.py agents .githooks docs)

safe_source_path() {
  local source=$1 path=$2 resolved source_real
  source_real=$(cd "$source" && pwd -P)
  path="$source/$path"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ -L "$path" ]]; then
    resolved=$(readlink -f "$path") || die "cannot resolve distribution symlink: $path"
    [[ "$resolved" == "$source_real"/* ]] || die "distribution symlink escapes source: $path"
  fi
}

is_experimental_content() {
  local line marked=1
  local manifest=$1
  if [[ -d "$manifest" && "$manifest" == */skills/* ]]; then
    manifest="$manifest/SKILL.md"
  elif [[ "$manifest" != */rules/*.md ]]; then
    return 1
  fi
  [[ -f "$manifest" ]] || return 1
  {
    IFS= read -r line || return 1
    [[ "${line%$'\r'}" == --- ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=${line%$'\r'}
      [[ "$line" == --- ]] && return "$marked"
      if [[ "$line" =~ ^experimental:[[:space:]]*true[[:space:]]*(#.*)?$ ]]; then marked=0; fi
    done
  } <"$manifest"
  return 1
}

copy_additive() {
  local source=$1 target=$2 item name
  mkdir -p "$target"
  for item in "$source"/* "$source"/.[!.]*; do
    [[ -e "$item" || -L "$item" ]] || continue
    name=${item##*/}; [[ "$name" == .git || "$name" == .gitignore ]] && continue
    safe_source_path "$source" "$name"
    if (( ! experimental )) && is_experimental_content "$item"; then continue; fi
    if [[ -L "$item" ]]; then
      safe_source_path "$source" "$name"
      if (( replace_managed )) || [[ ! -e "$target/$name" && ! -L "$target/$name" ]]; then
        rm -rf "$target/$name"; cp -a "$item" "$target/$name"
      fi
    elif [[ -d "$item" ]]; then
      copy_additive "$item" "$target/$name"
    elif (( replace_managed )) || [[ ! -e "$target/$name" && ! -L "$target/$name" ]]; then
      cp -a "$item" "$target/$name"
    fi
  done
}

backup_distribution() {
  local target=$1 backup_dir="$target/.thesystem/backups" id archive item
  id=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$backup_dir"
  archive="$backup_dir/$id.tar.gz"
  local existing=()
  for item in "${allowed_distribution_paths[@]}"; do
    [[ -e "$target/$item" || -L "$target/$item" ]] && existing+=("$item")
  done
  ((${#existing[@]})) || return 0
  tar -czf "$archive" -C "$target" "${existing[@]}"
  [[ -f "$target/.thesystem/managed.json" ]] && cp "$target/.thesystem/managed.json" "$backup_dir/$id.managed.json"
  printf '%s\n' "$id"
}

remove_distribution() {
  local target=$1
  [[ -f "$target/installer_lifecycle.py" ]] || die 'safe ownership cleanup is unavailable; preserving distribution'
  python3 "$target/installer_lifecycle.py" clean "$target" || die 'safe ownership cleanup failed; no destructive fallback'
}

upgrade_distribution() {
  local source=$1 target=$2 snapshot
  [[ -d "$target" ]] || die "cannot upgrade missing workspace: $target"
  snapshot=$(backup_distribution "$target") || die 'could not create upgrade backup'
  replace_managed=1
  provision_distribution "$source" "$target"
  python3 "$source/installer_lifecycle.py" snapshot "$source" "$target"
  printf '%s\n' "$snapshot" > "$target/.thesystem/active-backup"
  say "Upgraded distribution at $(cd "$target" && pwd -P); rollback snapshot: $snapshot"
}

rollback_distribution() {
  local target=$1 archive id
  [[ -d "$target/.thesystem/backups" ]] || die "no rollback snapshots found in $target"
  id=${rollback_id:-$(find "$target/.thesystem/backups" -maxdepth 1 -name '*.tar.gz' -printf '%f\n' | sort | tail -n 1)}
  id=${id%.tar.gz}; archive="$target/.thesystem/backups/$id.tar.gz"
  [[ -f "$archive" && -f "$target/.thesystem/backups/$id.managed.json" ]] || die "rollback snapshot or ownership manifest not found: $id"
  remove_distribution "$target"
  tar -xzf "$archive" -C "$target"
  cp "$target/.thesystem/backups/$id.managed.json" "$target/.thesystem/managed.json"
  say "Rolled back distribution at $(cd "$target" && pwd -P) to $id"
}

uninstall_distribution() {
  local target=$1
  [[ -d "$target" ]] || die "workspace not found: $target"
  remove_distribution "$target"
  if [[ -n "$company" && -f "$HOME/.local/bin/$company" ]] && python3 - "$HOME/.local/bin/$company" "$target" <<'PYLAUNCHER'
from pathlib import Path
import sys
s=Path(sys.argv[1]).read_text()
if s.startswith("#!/usr/bin/env bash\n") and "export THESYSTEM_WORKSPACE="+sys.argv[2] in s and "/company_cli.py" in s:
    Path(sys.argv[1]).unlink()
PYLAUNCHER
  then :; fi
  say "Removed theSystem software from $target; projects, source repositories, work records, and credentials were preserved"
}

provision_distribution() {
  local source=$1 target=$2 source_real target_abs item
  [[ ! -L "$target" ]] || die "refusing to provision through symlink workspace: $target"
  mkdir -p "$target"
  source_real=$(cd "$source" && pwd -P)
  target_abs=$(mkdir -p "$target" && cd "$target" && pwd -P)
  [[ "$target_abs" == "$source_real" || "$target_abs" == "$source_real"/* ]] && die 'workspace cannot be inside the distribution source'
  for item in "${allowed_distribution_paths[@]}"; do
    safe_source_path "$source_real" "$item"
    [[ -e "$source_real/$item" || -L "$source_real/$item" ]] || continue
    if [[ -d "$source_real/$item" && ! -L "$source_real/$item" ]]; then
      copy_additive "$source_real/$item" "$target_abs/$item"
    elif (( replace_managed )) || [[ ! -e "$target_abs/$item" && ! -L "$target_abs/$item" ]]; then
      cp -a "$source_real/$item" "$target_abs/$item"
    fi
  done
  say "Distribution provisioned at $target_abs"
}

link_project_skills() {
  local root=${1:-${repo_root:-}} link=${project_skills_link:-}
  [[ -n "$root" ]] || die 'project root is required for skill linking'
  [[ -n "$link" ]] || link="$root/.agents/skills"
  mkdir -p "$(dirname "$link")"
  if [[ -e "$link" && ! -L "$link" ]]; then die "refusing to replace non-symlink project skills path $link"; fi
  if [[ -L "$link" ]]; then
    [[ "$(readlink "$link")" == '../agents/skills' ]] || die "refusing to replace project skill link $link"
  else ln -s ../agents/skills "$link"; fi
}

profile_exists() {
  HERMES_HOME="$HERMES_HOME_ROOT" hermes profile list 2>/dev/null | awk -v p="$PROFILE" '$0 ~ "(^|[[:space:]])" p "([[:space:]]|$)" { found=1 } END { exit(found ? 0 : 1) }'
}
master_hermes() { HERMES_HOME="$HERMES_HOME_ROOT" hermes -p "$PROFILE" "$@"; }

configure_master_profile() {
  profile_exists && { say 'Hermes profile master already exists; preserving it'; return; }
  if (( non_interactive )); then die 'new master profile requires interactive official Blank Slate setup; no profile was created'
  fi
  [[ -r /dev/tty && -w /dev/tty ]] || die 'new master profile requires a terminal for official Blank Slate setup; no profile was created'
  say 'Creating dedicated Hermes profile master with no bundled skills'
  HERMES_HOME="$HERMES_HOME_ROOT" hermes profile create "$PROFILE" --no-skills
  profile_exists || die 'Hermes did not create a discoverable master profile'
  say 'Starting the official Hermes setup wizard; choose Blank Slate'
  master_hermes setup </dev/tty >/dev/tty 2>/dev/tty
}

resolve_hermes_python() {
  local launcher command_json python_path
  launcher=$(command -v hermes)
  command_json=$(HERMES_HOME="$HERMES_HOME_ROOT" "$launcher" --print-runtime-command) \
    || die "Hermes could not resolve its supported runtime from $launcher"
  python_path=$(python3 -c 'import json,sys; command=json.loads(sys.stdin.read()); print(command[0])' <<<"$command_json") \
    || die "Hermes returned an invalid runtime command"
  [[ -x "$python_path" ]] || die "Hermes runtime is not executable: $python_path"
  printf '%s\n' "$python_path"
}

# Run a Python file with the exact command published by Hermes.  In particular,
# do not invoke the interpreter from a shell wrapper directly: hermes_bootstrap
# creates the dependency/runtime path that the installer relies on.
run_hermes_python_file() {
  local script=$1; shift
  local command_json
  command_json=$(HERMES_HOME="$HERMES_HOME_ROOT" hermes --print-runtime-command) \
    || die 'Hermes could not publish its runtime command'
  python3 - "$command_json" "$script" "$@" <<'PY'
import json, os, subprocess, sys
command=json.loads(sys.argv[1])
if not isinstance(command, list) or len(command) < 4:
    raise SystemExit('Hermes returned an invalid runtime command')
script=sys.argv[2]
bootstrap=command[3]
marker="runpy.run_module('hermes_cli.main', run_name='__main__', alter_sys=True)"
if marker not in bootstrap:
    raise SystemExit('Hermes runtime command does not bootstrap hermes_cli.main')
code=bootstrap.replace(marker, "exec(compile(open(sys.argv[1], encoding='utf-8').read(), sys.argv[1], 'exec'))", 1)
env=os.environ.copy()
env['HERMES_HOME']=env.get('HERMES_HOME') or os.environ.get('HERMES_HOME_ROOT', '')
result=subprocess.run([command[0], '-I', '-c', code, script, *sys.argv[3:]], env=env)
raise SystemExit(result.returncode)
PY
}

canonical_entries() {
  local script; script=$(mktemp)
  cat >"$script" <<'PY'
import json, sys
from pathlib import Path
import yaml
p=Path(sys.argv[1]); doc=yaml.safe_load(p.read_text())
if not isinstance(doc, dict): raise SystemExit(f'{p} must contain a YAML mapping')
def emit(v, path=()):
    if isinstance(v, dict):
        for k, child in v.items():
            if not isinstance(k, str) or not k: raise SystemExit('invalid canonical key')
            emit(child, path+(k,))
    else:
        if not path: raise SystemExit('canonical configuration cannot be scalar')
        print('.'.join(path)+'\t'+json.dumps(v,separators=(',',':')))
emit(doc)
PY
  HERMES_HOME="$HERMES_HOME_ROOT" run_hermes_python_file "$script" "$1"
  rm -f "$script"
}

check_required_files() {
  local root=$1
  for f in agents/.harness/canonical_config.yaml agents/.harness/required_toolsets.txt agents/skills/memory-request-review/requirements.txt; do
    [[ -f "$root/$f" ]] || die "missing required distribution file: $root/$f"
  done
  require_command python3; require_command uv
}

enable_required_toolsets() {
  local root=$1 line previous; local -a names=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" =~ ^[a-z][a-z0-9_]*$ ]] || die "invalid required toolset name: $line"
    for previous in "${names[@]}"; do [[ "$previous" != "$line" ]] || die "duplicate toolset name: $line"; done
    names+=("$line")
  done < "$root/agents/.harness/required_toolsets.txt"
  ((${#names[@]})) || die 'required toolset manifest is empty'
  master_hermes tools enable --platform cli "${names[@]}"
}

provision_memory_review() {
  local root=$1 env_dir req runtime runtime_paths path_script
  env_dir="$root/.agents/memory-review"
  req="$root/agents/skills/memory-request-review/requirements.txt"
  runtime=$(resolve_hermes_python)
  if [[ ! -x "$env_dir/bin/python" ]]; then uv venv --python "$runtime" "$env_dir"; fi
  uv pip install --python "$env_dir/bin/python" --requirements "$req"
  path_script=$(mktemp)
  printf '%s\n' 'import json,sys; print(json.dumps([p for p in sys.path if "site-packages" in p]))' > "$path_script"
  runtime_paths=$(run_hermes_python_file "$path_script") || die 'Hermes runtime dependency paths unavailable'
  rm -f "$path_script"
  "$env_dir/bin/python" - "$runtime" "$runtime_paths" <<'PY'
import json, subprocess, sys, sysconfig
from pathlib import Path
import ast
runtime=subprocess.run([sys.argv[1],'-I','-c','import json,site,sys; print(json.dumps([list(sys.version_info[:2]),site.getsitepackages()]))'],check=True,capture_output=True,text=True)
version, paths=json.loads(runtime.stdout)
paths.extend(json.loads(sys.argv[2]))
if version != list(sys.version_info[:2]): raise SystemExit('review environment Python differs from Hermes')
command=subprocess.run(['hermes','--print-runtime-command'],check=True,capture_output=True,text=True)
bootstrap=json.loads(command.stdout)[3]
roots=[]
for node in ast.walk(ast.parse(bootstrap)):
    if isinstance(node,ast.Call) and isinstance(node.func,ast.Attribute) and node.func.attr=='insert' and isinstance(node.func.value,ast.Attribute) and node.func.value.attr=='path' and len(node.args)>=2 and isinstance(node.args[1],ast.Constant) and isinstance(node.args[1].value,str):
        candidate=Path(node.args[1].value)
        if candidate.is_absolute() and (candidate/'hermes_cli').is_dir(): roots.append(str(candidate))
if len(roots)!=1: raise SystemExit('Hermes runtime did not publish one source root')
target=Path(sysconfig.get_path('purelib'))/'hermes-runtime.pth'
target.write_text('import site; '+'; '.join(f'site.addsitedir({p!r})' for p in [*paths,*roots])+'\n')
PY
  uv pip check --python "$env_dir/bin/python"
  "$env_dir/bin/python" -c 'from typesafe_sdk import Noul, TypeSafeClient; from tools import write_approval; from hermes_cli.write_approval_commands import _apply_one; from importlib.metadata import version; print("typesafe-sdk " + version("typesafe-sdk"))'
}

trust_and_verify_skills() {
  local root=$1
  master_hermes skills trust "$root" >/dev/null
  local script; script=$(mktemp)
  cat >"$script" <<'PY'
from pathlib import Path
import sys
from agent.skill_utils import get_project_skills_dirs, iter_project_skill_files, iter_skill_index_files
root=Path(sys.argv[1]); skill_root=root/'.agents'/'skills'
expected={str(p.parent.relative_to(skill_root)) for p in iter_skill_index_files(skill_root,'SKILL.md')}
accepted={str(p.parent.relative_to(d)) for d in get_project_skills_dirs() for p in iter_project_skill_files(d)}
missing=expected-accepted
if missing: raise SystemExit('project skills unavailable after Hermes security filtering: '+', '.join(sorted(missing)))
PY
  HERMES_HOME="$HERMES_HOME_ROOT" TERMINAL_CWD="$root" run_hermes_python_file "$script" "$root"
  rm -f "$script"
}

install_system_config() {
  local root=$1 entries key value
  entries=$(mktemp)
  canonical_entries "$root/agents/.harness/canonical_config.yaml" >"$entries" || { rm -f "$entries"; die 'unable to parse canonical configuration'; }
  [[ -s "$entries" ]] || { rm -f "$entries"; die 'canonical configuration contains no settings'; }
  while IFS=$'\t' read -r key value; do master_hermes config set --force "$key" "$value" >/dev/null; done <"$entries"
  rm -f "$entries"
}

pin_global_skills() {
  local root=$1 usage skill usage_file names_file profile_home
  profile_home="$HERMES_HOME_ROOT/profiles/$PROFILE"
  usage=$(master_hermes curator usage --json)
  usage_file=$(mktemp)
  printf '%s\n' "$usage" >"$usage_file"
  names_file=$(mktemp)
  python3 - "$root" "$profile_home" "$usage_file" >"$names_file" <<'PY'
import json,sys
from pathlib import Path
entries=json.loads(Path(sys.argv[3]).read_text())
if not isinstance(entries,list): raise SystemExit('expected curator usage list')
known={e['name']:e for e in entries if isinstance(e,dict) and isinstance(e.get('name'),str)}
root=Path(sys.argv[1])/'agents'/'skills'; side=Path(sys.argv[2])/'skills'/'.usage.json'
recorded=json.loads(side.read_text()) if side.exists() else {}
for p in sorted(root.rglob('SKILL.md')):
 n=p.parent.name; e=known.get(n,{})
 if e.get('provenance') not in ('bundled','hub') and not recorded.get(n,{}).get('pinned',False): print(n)
PY
  while IFS= read -r skill; do [[ -n "$skill" ]] && master_hermes curator pin "$skill"; done <"$names_file"
  rm -f "$usage_file" "$names_file"
}

install_company_cli() {
  local root=$1 target source_path launcher
  [[ -n "$company" ]] || return
  validate_company_name "$company"
  target="$HOME/.local/bin/$company"
  source_path="$root/company_cli.py"
  [[ -f "$source_path" ]] || die "missing company CLI source: $source_path"
  launcher=$(mktemp)
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' \
    "export THESYSTEM_WORKSPACE=$(printf '%q' "$(cd "$root" && pwd -P)")" \
    "exec $(printf '%q' "$(command -v python3)") $(printf '%q' "$source_path") \"\$@\"" >"$launcher"
  if [[ -e "$target" || -L "$target" ]]; then
    cmp -s "$launcher" "$target" || { rm -f "$launcher"; die "company command already exists; refusing to overwrite: $company"; }
    rm -f "$launcher"
    say "Company command $company already installed at $target"
    return
  fi
  if command -v "$company" >/dev/null 2>&1; then
    rm -f "$launcher"
    die "company command already exists; refusing to overwrite: $company"
  fi
  mkdir -p "$(dirname "$target")"
  mv "$launcher" "$target"
  chmod 0755 "$target"
  say "Installed company command $company at $target"
}

main() {
  [[ -n "$company" ]] && validate_company_name "$company"
  if [[ -n "$company" ]]; then
    local existing_company
    existing_company=$(command -v "$company" 2>/dev/null || true)
    [[ -z "$existing_company" || "$existing_company" == "$HOME/.local/bin/$company" ]] \
      || die "company command already exists; refusing to overwrite: $company"
  fi
  if [[ "$lifecycle" == rollback || "$lifecycle" == uninstall ]]; then
    ask_workspace
    [[ "$workspace" = /* ]] || workspace="$PWD/$workspace"
    if [[ "$lifecycle" == rollback ]]; then rollback_distribution "$workspace"; else uninstall_distribution "$workspace"; fi
    return
  fi
  ensure_python
  if [[ "$runtime" != none ]]; then ensure_runtime_prerequisites; fi
  if [[ "$runtime" == hermes ]]; then
    ensure_hermes
    ensure_uv
  elif [[ "$runtime" == copilot ]]; then
    ensure_copilot
  fi
  ask_workspace
  ask_company
  [[ "$workspace" = /* ]] || workspace="$PWD/$workspace"
  local source
  if source=$(find_local_distribution); then :; else source=$(download_distribution); fi
  if [[ "$lifecycle" == upgrade ]]; then upgrade_distribution "$source" "$workspace"; else provision_distribution "$source" "$workspace"; python3 "$source/installer_lifecycle.py" snapshot "$source" "$workspace"; fi
  if [[ "$runtime" != none ]]; then ensure_herdr; fi
  if [[ "$runtime" == hermes ]]; then
    link_project_skills "$workspace"
    configure_master_profile
    check_required_files "$workspace"
    enable_required_toolsets "$workspace"
    provision_memory_review "$workspace"
    trust_and_verify_skills "$workspace"
    install_system_config "$workspace"
    pin_global_skills "$workspace"
  elif [[ "$runtime" == copilot ]]; then
    link_project_skills "$workspace"
  fi
  mkdir -p "$workspace/.thesystem"
  printf "%s\n" "$runtime" > "$workspace/.thesystem/runtime"
  install_company_cli "$workspace"
  say "Ready. Runtime: $runtime; workspace: $(cd "$workspace" && pwd -P)"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
