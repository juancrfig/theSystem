#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: thesystem <install|configure|doctor|upgrade|rollback|uninstall|workspace-command> [OPTIONS]' \
    '' \
    'Use "thesystem <command> --help" for command details. No arguments show this help.'
}

args=("$@")
if ((${#args[@]} == 0)) || [[ "${args[0]}" == -h || "${args[0]}" == --help ]]; then
  usage
  exit 0
fi
command_index=0
while ((command_index < ${#args[@]})); do
  case "${args[command_index]}" in
    --workspace)
      if ((command_index + 1 >= ${#args[@]})); then
        printf 'thesystem: --workspace requires a path\n' >&2
        exit 2
      fi
      command_index=$((command_index + 2))
      ;;
    --json) command_index=$((command_index + 1)) ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done
if ((command_index == ${#args[@]})); then
  if [[ " ${args[*]} " == *" --json "* ]]; then
    printf '%s\n' '{"status":"error","code":"JSON_COMMAND_REQUIRED","message":"--json requires a non-interactive command"}'
    exit 2
  fi
  usage
  exit 0
fi
case "${args[command_index]}" in
  install|configure|doctor|upgrade|rollback|uninstall|add-project|add-source-clone|set-role|retry|evidence|learning|orchestrator|create-task|approve|start|status|cancel|integrate) ;;
  *) usage >&2; printf 'Unknown command: %s\n' "${args[command_index]}" >&2; exit 2 ;;
esac

source_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
if [[ ! -f "$source_root/thesystem/cli.py" ]]; then
  source_root="${THESYSTEM_SOURCE_ROOT:-}"
fi
if [[ -z "$source_root" || ! -f "$source_root/thesystem/cli.py" ]]; then
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/thesystem/source"
  mkdir -p "$(dirname "$cache")"
  temp_root="${TMPDIR:-${XDG_CACHE_HOME:-$HOME/.cache}}"
  mkdir -p "$temp_root"
  archive=$(mktemp "$temp_root/thesystem.XXXXXX.tar.gz")
  trap 'rm -f "$archive"' EXIT
  command -v curl >/dev/null 2>&1 || { printf 'curl is required to acquire theSystem source\n' >&2; exit 1; }
  command -v tar >/dev/null 2>&1 || { printf 'tar is required to acquire theSystem source\n' >&2; exit 1; }
  url="${THESYSTEM_ARCHIVE_URL:-https://codeload.github.com/juancrfig/theSystem/tar.gz/refs/heads/${THESYSTEM_BRANCH:-master}}"
  curl --fail --location --silent --show-error "$url" -o "$archive"
  stage=$(mktemp -d "$temp_root/thesystem-source.XXXXXX")
  tar -tzf "$archive" | awk '
    BEGIN { ok=0; root="" }
    /^\// { bad=1 }
    {
      count=split($0, parts, "/")
      if (parts[1] == "" || parts[1] == "." || parts[1] == "..") bad=1
      for (i=1; i<=count; i++) if (parts[i] == "..") bad=1
      if (root == "") root=parts[1]; else if (root != parts[1]) bad=1
      if ($0 ~ /\/bin\/thesystem$/) ok=1
    }
    END { exit (bad || !ok) }
  ' || { rm -rf "$stage"; printf 'Downloaded archive is not a safe theSystem distribution\n' >&2; exit 1; }
  tar -tvzf "$archive" | awk 'substr($0,1,1) == "l" || substr($0,1,1) == "h" {bad=1} END {exit bad}' || { rm -rf "$stage"; printf 'Downloaded archive contains unsupported links\n' >&2; exit 1; }
  tar -xzf "$archive" -C "$stage"
  extracted=$(printf '%s\n' "$stage"/*)
  [[ -f "$extracted/thesystem/cli.py" && -f "$extracted/thesystem/setup/distribution.py" ]] || { rm -rf "$stage"; printf 'Downloaded archive failed source validation\n' >&2; exit 1; }
  mkdir -p "$cache"
  source_id="source-$(date +%s)-$$-${RANDOM}"
  mv "$extracted" "$cache/$source_id"
  rmdir "$stage"
  source_root="$cache/$source_id"
fi

if ! command -v python3 >/dev/null 2>&1; then
  privilege=()
  if [[ "$(id -u)" != 0 ]]; then
    command -v sudo >/dev/null 2>&1 || { printf 'Python 3 is required; install it and retry\n' >&2; exit 1; }
    privilege=(sudo)
  fi
  if command -v apt-get >/dev/null 2>&1; then
    "${privilege[@]}" apt-get update
    "${privilege[@]}" apt-get install -y python3
  elif command -v pacman >/dev/null 2>&1; then
    "${privilege[@]}" pacman -Sy --needed --noconfirm python
  else
    printf 'Python 3 is required; no supported package manager found\n' >&2
    exit 1
  fi
fi
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$source_root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -B -m thesystem.command "${args[@]}"
