#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF_USAGE'
Usage: ./bootstrap [--plain]

Configures this checkout as a Hermes workspace.

Output is an interactive checklist when stdout is a terminal. Otherwise, or
with --plain (or BOOTSTRAP_OUTPUT=plain), each event is one stable line:

  bootstrap step=<id> status=running
  bootstrap step=<id> status=done [detail="..."]
  bootstrap step=<id> status=failed
  bootstrap status=ok|failed

Exit status is 0 on success, 1 on failure, and 2 on invalid arguments.
EOF_USAGE
}

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
canonical_config="$repo_root/agents/.harness/canonical_config.tsv"
canonical_profiles="$repo_root/agents/.harness/canonical_profiles.txt"
project_skills_link="$repo_root/.agents/skills"
default_hermes_home="$HOME/.hermes"
memory_review_requirements="$repo_root/agents/skills/memory-request-review/requirements.txt"
memory_review_env="$repo_root/.agents/memory-review"
required_toolsets="$repo_root/agents/.harness/required_toolsets.txt"

require_file() {
  if [[ ! -f "$1" ]]; then
    printf 'Missing required file: %s\n' "$1" >&2
    exit 1
  fi
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command is not available: %s\n' "$1" >&2
    exit 1
  fi
}

set_config() {
  local profile=$1 key=$2 value=$3
  HERMES_HOME="$default_hermes_home" hermes -p "$profile" config set --force "$key" "$value" >/dev/null
}

profile_exists() {
  local profile=$1
  HERMES_HOME="$default_hermes_home" hermes profile list 2>/dev/null | awk -v p="$profile" '$0 ~ "(^|[[:space:]])" p "([[:space:]]|$)" { found=1 } END { exit(found ? 0 : 1) }'
}

ensure_profile_exists() {
  local profile=$1
  if ! profile_exists "$profile"; then
    HERMES_HOME="$default_hermes_home" hermes profile create "$profile" --no-skills >/dev/null
  fi
}

resolve_hermes_python() {
  local hermes_launcher hermes_shebang hermes_python
  hermes_launcher=$(command -v hermes)
  IFS= read -r hermes_shebang < "$hermes_launcher"
  if [[ "$hermes_shebang" == '#!'/* && "$hermes_shebang" != '#!/usr/bin/env '* ]]; then
    hermes_python=${hermes_shebang#\#!}
  else
    while IFS= read -r line; do
      case "$line" in
        'exec "'*)
          hermes_python=${line#exec \"}
          hermes_python=${hermes_python%%\"*}
          break
          ;;
      esac
    done < "$hermes_launcher"
  fi
  if [[ -z "${hermes_python:-}" || ! -x "$hermes_python" ]]; then
    printf 'Unable to resolve Hermes Python runtime from: %s\n' "$hermes_launcher" >&2
    exit 1
  fi
  printf '%s\n' "$hermes_python"
}

verify_project_skills() {
  local hermes_python
  hermes_python=$(resolve_hermes_python)
  HERMES_HOME="$default_hermes_home" TERMINAL_CWD="$repo_root" "$hermes_python" - "$repo_root" <<'PY'
from pathlib import Path
import sys

from agent.skill_utils import get_project_skills_dirs, iter_project_skill_files, iter_skill_index_files

root = Path(sys.argv[1])
skill_root = root / ".agents" / "skills"
expected = {str(path.parent.relative_to(skill_root)) for path in iter_skill_index_files(skill_root, "SKILL.md")}
accepted = {
    str(path.parent.relative_to(directory))
    for directory in get_project_skills_dirs()
    for path in iter_project_skill_files(directory)
}
unavailable = expected - accepted
if unavailable:
    print("Project skills unavailable after Hermes security filtering: " + ", ".join(sorted(unavailable)), file=sys.stderr)
    raise SystemExit(1)
print(f"{len(accepted)} skills accepted")
PY
}

canonical_entries() {
  python3 - "$canonical_config" <<'PY'
import json
import sys
from pathlib import Path

source = Path(sys.argv[1])
text = source.read_text(encoding='utf-8')
if not text.strip():
    raise SystemExit(f"{source} is empty")

for line_no, raw in enumerate(text.splitlines(), start=1):
    line = raw.strip()
    if not line or line.startswith('#'):
        continue
    if '\t' not in raw:
        raise SystemExit(f"{source}:{line_no}: expected <key>\\t<json-value>")
    key, value = raw.split('\t', 1)
    key = key.strip()
    value = value.strip()
    if not key:
        raise SystemExit(f"{source}:{line_no}: empty key")
    for segment in key.split('.'):
        if not segment or any(ch.isspace() for ch in segment):
            raise SystemExit(f"{source}:{line_no}: invalid key segment in {key!r}")
    parsed = json.loads(value)
    print(f"{key}\t{json.dumps(parsed, separators=(',', ':'))}")
PY
}

canonical_profiles_list() {
  python3 - "$canonical_profiles" <<'PY'
import re
import sys
from pathlib import Path

source = Path(sys.argv[1])
text = source.read_text(encoding='utf-8')
if not text.strip():
    raise SystemExit(f"{source} is empty")

seen = set()
for line_no, raw in enumerate(text.splitlines(), start=1):
    line = raw.strip()
    if not line or line.startswith('#'):
        continue
    if not re.fullmatch(r"[a-z][a-z0-9]*", line):
        raise SystemExit(f"{source}:{line_no}: invalid profile name {line!r}")
    if line in seen:
        raise SystemExit(f"{source}:{line_no}: duplicate profile name {line!r}")
    seen.add(line)
    print(line)
PY
}

check_prerequisites() {
  require_file "$canonical_config"
  require_file "$canonical_profiles"
  require_file "$required_toolsets"
  require_file "$repo_root/.githooks/pre-commit"
  require_file "$memory_review_requirements"
  require_command hermes
  require_command python3
  require_command uv
}

enable_required_toolsets() {
  local toolset previous='' names=()
  while IFS= read -r toolset || [[ -n "$toolset" ]]; do
    [[ -z "$toolset" || "$toolset" == \#* ]] && continue
    [[ "$toolset" =~ ^[a-z][a-z0-9_]*$ ]] || { printf 'Invalid required toolset name: %s\n' "$toolset" >&2; exit 1; }
    for previous in "${names[@]}"; do
      [[ "$previous" != "$toolset" ]] || { printf 'Duplicate toolset name: %s\n' "$toolset" >&2; exit 1; }
    done
    names+=("$toolset")
  done < "$required_toolsets"
  ((${#names[@]})) || { printf 'Required toolset manifest is empty: %s\n' "$required_toolsets" >&2; exit 1; }
  HERMES_HOME="$default_hermes_home" hermes tools enable --platform cli "${names[@]}"
  step_detail="${#names[@]} required toolsets"
}

provision_memory_review() {
  local hermes_python
  hermes_python=$(resolve_hermes_python)
  if [[ ! -x "$memory_review_env/bin/python" ]]; then
    uv venv --python "$hermes_python" "$memory_review_env"
  fi
  uv pip install --python "$memory_review_env/bin/python" --requirements "$memory_review_requirements"
  # Native decisions need Hermes and its dependencies without installing the SDK
  # into Hermes's own environment. Local review packages take precedence.
  "$memory_review_env/bin/python" - "$hermes_python" <<'PY'
import json
from pathlib import Path
import subprocess
import sys
import sysconfig

runtime = subprocess.run(
    [sys.argv[1], "-I", "-c", "import json, site, sys; print(json.dumps([list(sys.version_info[:2]), site.getsitepackages()]))"],
    check=True, capture_output=True, text=True,
)
version, paths = json.loads(runtime.stdout)
if version != list(sys.version_info[:2]):
    raise SystemExit("Review environment Python differs from Hermes; recreate .agents/memory-review and rerun bootstrap.")
target = Path(sysconfig.get_path("purelib")) / "hermes-runtime.pth"
target.write_text("import site; " + "; ".join(f"site.addsitedir({path!r})" for path in paths) + "\n", encoding="utf-8")
PY
  uv pip check --python "$memory_review_env/bin/python"
  "$memory_review_env/bin/python" -c 'from typesafe_sdk import Noul, TypeSafeClient; from tools import write_approval; from hermes_cli.write_approval_commands import _apply_one; from importlib.metadata import version; print("typesafe-sdk " + version("typesafe-sdk"))'
  step_detail='isolated review environment ready'
}

# Keep the hook setup versioned with the checkout rather than in the README.
configure_git_hooks() {
  git -C "$repo_root" config core.hooksPath .githooks
}

# Reconcile the default profile from the declaration instead of repeating its
# settings here. New canonical keys are applied automatically on the next run;
# credentials and unrelated device settings remain untouched.
apply_canonical_config() {
  local profile key value setting profile_count=0 canonical_setting_count=0
  local profiles_raw settings_raw
  local -a profiles settings

  profiles_raw=$(canonical_profiles_list)
  settings_raw=$(canonical_entries)

  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    profiles+=("$profile")
  done <<<"$profiles_raw"
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] || continue
    settings+=("$key"$'\t'"$value")
  done <<<"$settings_raw"

  profile_count=${#profiles[@]}
  canonical_setting_count=${#settings[@]}
  if (( profile_count == 0 )); then
    printf 'Canonical profile declaration contains no profiles: %s\n' "$canonical_profiles" >&2
    exit 1
  fi
  if (( canonical_setting_count == 0 )); then
    printf 'Canonical configuration contains no settings: %s\n' "$canonical_config" >&2
    exit 1
  fi
  for profile in "${profiles[@]}"; do
    ensure_profile_exists "$profile"
    for setting in "${settings[@]}"; do
      IFS=$'\t' read -r key value <<<"$setting"
      set_config "$profile" "$key" "$value"
    done
  done
  step_detail="$canonical_setting_count settings x $profile_count profiles"
}

# Also expose the skills through Hermes's project-local convention. This gives
# them project precedence when Hermes is started inside this checkout.
link_project_skills() {
  mkdir -p "$(dirname "$project_skills_link")"
  if [[ -e "$project_skills_link" && ! -L "$project_skills_link" ]]; then
    printf 'Refusing to replace non-symlink project skill directory: %s\n' "$project_skills_link" >&2
    exit 1
  fi
  if [[ -L "$project_skills_link" ]]; then
    local existing_target
    existing_target=$(readlink "$project_skills_link")
    if [[ "$existing_target" != '../agents/skills' ]]; then
      printf 'Refusing to replace project skill link %s -> %s\n' "$project_skills_link" "$existing_target" >&2
      exit 1
    fi
  else
    ln -s ../agents/skills "$project_skills_link"
  fi
}

trust_repository() {
  HERMES_HOME="$default_hermes_home" hermes skills trust "$repo_root" >/dev/null
}

verify_skills() {
  step_detail=$(verify_project_skills)
}

# The repository's global skill declarations are the source of truth. Hermes
# refuses pins for bundled/hub skills (already exempt from curation).
pin_global_skills() {
  local usage skill_names skill pinned_count=0
  usage=$(HERMES_HOME="$default_hermes_home" hermes curator usage --json)
  skill_names=$(python3 -c '
import json
import sys
from pathlib import Path

skills = json.load(sys.stdin)
if not isinstance(skills, list):
    raise SystemExit("Expected a list of curator skills")
known = {}
for entry in skills:
    if not isinstance(entry, dict) or not isinstance(entry.get("name"), str) or not entry["name"]:
        raise SystemExit("Invalid curator skill entry")
    known[entry["name"]] = entry
root = Path(sys.argv[1]) / "agents" / "skills"
sidecar = Path(sys.argv[2]) / "skills" / ".usage.json"
recorded = json.loads(sidecar.read_text()) if sidecar.exists() else {}
if not isinstance(recorded, dict):
    raise SystemExit(f"Invalid curator usage sidecar: {sidecar}")
manifests = list(root.rglob("SKILL.md"))
if not manifests:
    raise SystemExit(f"No global skills found in {root}")
for name in sorted({path.parent.name for path in manifests}):
    entry = known.get(name, {})
    if entry.get("provenance") not in ("bundled", "hub") and not recorded.get(name, {}).get("pinned", False):
        print(name)
' "$repo_root" "$default_hermes_home" <<<"$usage")
  while IFS= read -r skill; do
    [[ -n "$skill" ]] || continue
    HERMES_HOME="$default_hermes_home" hermes curator pin "$skill"
    ((pinned_count += 1))
  done <<<"$skill_names"
  step_detail="$pinned_count newly pinned"
}

steps=(
  "prerequisites|Check prerequisites|check_prerequisites"
  "toolsets|Enable required Hermes toolsets|enable_required_toolsets"
  "memory-review|Prepare memory review environment|provision_memory_review"
  "git-hooks|Configure git hooks|configure_git_hooks"
  "hermes-config|Apply canonical Hermes config|apply_canonical_config"
  "skills-link|Link project-local skills|link_project_skills"
  "skills-trust|Trust this repository|trust_repository"
  "skills-verify|Verify project skills|verify_skills"
  "skills-pin|Pin curator-managed global skills|pin_global_skills"
)

output_mode=fancy
for argument in "$@"; do
  case "$argument" in
    --plain) output_mode=plain ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if [[ "${BOOTSTRAP_OUTPUT:-}" == plain || ! -t 1 || "${TERM:-dumb}" == dumb ]]; then
  output_mode=plain
fi

if [[ -z "${NO_COLOR:-}" && "$output_mode" == fancy ]]; then
  green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' reset=$'\e[0m'
else
  green='' red='' dim='' reset=''
fi

step_log=$(mktemp)
current_step=''
spinner_pid=''
step_detail=''

# Each checklist row sits a fixed distance above the cursor, which rests below
# the list, so rows can be redrawn in place without a full-screen redraw.
draw_row() {
  local index=$1 box=$2 label=$3 suffix=${4:-}
  local rows_up=$(( ${#steps[@]} - index + 1 ))
  printf '\e[%dA\r\e[K  %s %s%s\e[%dB\r' "$rows_up" "$box" "$label" "$suffix" "$rows_up"
}

start_spinner() {
  local index=$1 label=$2
  (
    local dots=('.  ' '.. ' '...')
    local frame=0
    while true; do
      draw_row "$index" '[ ]' "$label" " ${dim}${dots[frame]}${reset}"
      frame=$(( (frame + 1) % 3 ))
      sleep 0.3
    done
  ) &
  spinner_pid=$!
}

stop_spinner() {
  if [[ -n "$spinner_pid" ]]; then
    kill "$spinner_pid" 2>/dev/null || true
    wait "$spinner_pid" 2>/dev/null || true
    spinner_pid=''
  fi
}

draw_menu() {
  local step
  printf '\n'
  for step in "${steps[@]}"; do
    IFS='|' read -r _ label _ <<<"$step"
    printf '  [ ] %s\n' "$label"
  done
  printf '\e[?25l'
}

run_step() {
  local index=$1 id label action
  IFS='|' read -r id label action <<<"${steps[index - 1]}"
  current_step=$index
  step_detail=''
  if [[ "$output_mode" == fancy ]]; then
    start_spinner "$index" "$label"
    "$action" >"$step_log" 2>&1
    stop_spinner
    draw_row "$index" "[${green}x${reset}]" "$label" "${step_detail:+  ${dim}${step_detail}${reset}}"
  else
    printf 'bootstrap step=%s status=running\n' "$id"
    "$action"
    printf 'bootstrap step=%s status=done%s\n' "$id" "${step_detail:+ detail=\"$step_detail\"}"
  fi
  current_step=''
}

finish() {
  local status=$?
  exec 1>&3 2>&4
  stop_spinner
  if [[ "$output_mode" == fancy ]]; then
    if [[ -n "$current_step" ]]; then
      local label
      IFS='|' read -r _ label _ <<<"${steps[current_step - 1]}"
      draw_row "$current_step" "[${red}!${reset}]" "$label"
      sed 's/^/  /' "$step_log" >&2
    fi
    printf '\e[?25h'
    if (( status == 0 )); then
      printf '\n  %sReady.%s Hermes profile, git hooks, and project skills are configured.\n\n' "$green" "$reset"
    else
      printf '\n  %sBootstrap failed.%s\n\n' "$red" "$reset" >&2
    fi
  else
    if [[ -n "$current_step" ]]; then
      local id
      IFS='|' read -r id _ <<<"${steps[current_step - 1]}"
      printf 'bootstrap step=%s status=failed\n' "$id"
    fi
    printf 'bootstrap status=%s\n' "$( (( status == 0 )) && echo ok || echo failed)"
  fi
  rm -f "$step_log"
}
exec 3>&1 4>&2
trap finish EXIT
trap 'exit 130' INT TERM

if [[ "$output_mode" == fancy ]]; then
  draw_menu
fi
for (( step_index = 1; step_index <= ${#steps[@]}; step_index++ )); do
  run_step "$step_index"
done
